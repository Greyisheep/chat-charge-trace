# Monnify sandbox credentials (https://app.monnify.com -> sandbox)
MONNIFY_API_KEY=MK_TEST_XXXXXXXXXX
MONNIFY_SECRET_KEY=XXXXXXXXXX
MONNIFY_CONTRACT_CODE=XXXXXXXXXX
MONNIFY_BASE_URL=https://sandbox.monnify.com

# Gemini (agent model)
GOOGLE_API_KEY=XXXXXXXXXX
GOOGLE_MODEL_NAME=gemini-flash-latest

# Native voice (Gemini Live API). The live model is separate from the text
# model above. Leave VITE_VOICE_NATIVE empty to keep the browser voice floor;
# set it to 1 to use the native Gemini Live websocket.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
VITE_VOICE_NATIVE=

# Postgres (docker compose up -d starts it on 5433)
DATABASE_URL=postgresql+asyncpg://oja:oja@localhost:5433/oja

# Frontend (Vite reads these at build time; the API key here is the public key)
VITE_API_BASE_URL=http://localhost:8000
VITE_MONNIFY_API_KEY=MK_TEST_XXXXXXXXXX
VITE_MONNIFY_CONTRACT_CODE=XXXXXXXXXX

OTEL_SERVICE_NAME=oja-connect-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=always_on

# --- Deep agentic observability (issue #11) -------------------------------
# These four are read by ADK / OpenTelemetry directly from the process
# environment (NOT set from Python). They must be REAL env vars, so keep them
# here and let the app load .env (pydantic-settings / compose env_file).
#
# schema v2 turns on the semconv-aligned, token-bearing attributes
# (gen_ai.usage.input_tokens / output_tokens / cache_read.input_tokens) AND
# emits the invoke_workflow entrypoint span + metric. Our checkout is an ADK
# Workflow graph, so v2 is what makes the graph entrypoint legible.
ADK_TELEMETRY_SCHEMA_VERSION_OPT_IN=2
# Opt in to the latest experimental gen_ai semantic conventions.
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# EVENT_ONLY keeps prompt / response CONTENT as OTel log events (-> Loki) and
# OFF spans. Bodies on spans would hit Tempo's silent 2048-byte attribute
# truncation and leak buyer PII into the trace store; log events avoid both.
# (see #11)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY
# Legacy ADK knob that would copy message content back ONTO spans. Must stay
# false so it does not undo EVENT_ONLY above. (see #11)
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false

# Signal-specific OTLP endpoints. Default is the collector's OTLP/HTTP port;
# the /v1/metrics and /v1/logs suffixes are the standard OTLP/HTTP paths.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs

# Langfuse is used via Langfuse CLOUD, wired through the official Langfuse skill
# as a separate follow-up (see #11), so no self-hosted Langfuse keys live here.
